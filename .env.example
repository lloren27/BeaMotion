# Copia la URL y la clave publicable del .env del proyecto Lovable.
# Nunca añadas SYNC_API_KEY ni claves service_role a la aplicación móvil.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Proyecto Supabase propio de BeaMotion para los planes y resultados de entrenamiento.
# Crea aquí la misma cuenta administradora de la app; no reutilices la clave service_role.
EXPO_PUBLIC_TRAINING_SUPABASE_URL=
EXPO_PUBLIC_TRAINING_SUPABASE_PUBLISHABLE_KEY=
